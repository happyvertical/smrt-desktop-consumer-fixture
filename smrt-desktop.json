{
  "version": 1,
  "productId": "smrt-desktop-consumer-fixture",
  "bundleId": "invalid.example.smrt-desktop-consumer-fixture",
  "displayName": "SMRT Desktop Consumer Fixture",
  "bridge": {
    "envPrefix": "SMRT_CONSUMER_FIXTURE",
    "mcpPath": "/mcp"
  },
  "sidecar": {
    "healthRoute": "/api/_runtime/health",
    "ownerClaimRoute": "/api/_runtime/owner-link",
    "dataDirectory": "runtime"
  },
  "acknowledgedDynamicImports": [
    {
      "from": "@happyvertical/ai",
      "specifier": "@anthropic-ai/sdk"
    },
    {
      "from": "@happyvertical/ai",
      "specifier": "@google/genai"
    },
    {
      "from": "@happyvertical/ai",
      "specifier": "openai"
    },
    {
      "from": "@happyvertical/sql",
      "specifier": "@duckdb/node-api"
    },
    {
      "from": "@happyvertical/smrt-core",
      "specifier": "tsx"
    },
    {
      "from": "@happyvertical/smrt-core",
      "specifier": "oxc-transform"
    }
  ],
  "icons": [
    "icons/128x128.png",
    "icons/32x32.png",
    "icons/icon.ico",
    "icons/icon.png"
  ]
}
